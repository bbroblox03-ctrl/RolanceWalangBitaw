-- ========================
-- CONFIG & AUTO RE-EXECUTE
-- ========================

local SCRIPT_URL = "https://pastebin.com/raw/JQ0tys1Y"

local CONFIG_FILE = "KYYPIE_SlimeRNG_Config.json"
local defaultConfig = {
    AutoOn = false,
    AutoReExec = false,
}

local config = {}

local function saveConfig()
    if writefile then
        local ok, encoded = pcall(function() return HttpService:JSONEncode(config) end)
        if ok then
            pcall(function() writefile(CONFIG_FILE, encoded) end)
        end
    end
end

local function loadConfig()
    if readfile then
        local ok, data = pcall(function() return readfile(CONFIG_FILE) end)
        if ok and data and data ~= "" then
            local ok2, decoded = pcall(function() return HttpService:JSONDecode(data) end)
            if ok2 and type(decoded) == "table" then
                for k, v in pairs(defaultConfig) do
                    config[k] = decoded[k] ~= nil and decoded[k] or v
                end
                return
            end
        end
    end
    for k, v in pairs(defaultConfig) do config[k] = v end
end

loadConfig()

local function setupAutoReexecute()
    if not config.AutoReExec then return end
    if SCRIPT_URL == "" then
        warn("[KYYPIE] Auto ReExec is ON but SCRIPT_URL is empty!")
        return
    end
    local queue = queue_on_teleport
        or (syn and syn.queue_on_teleport)
        or (fluxus and fluxus.queue_on_teleport)
    if queue then
        queue('loadstring(game:HttpGet("' .. SCRIPT_URL .. '"))()')
        print("[KYYPIE] Queued for re-execution on teleport/rejoin")
    else
        warn("[KYYPIE] Auto ReExec not supported on this executor")
    end
end

