local function getZonesFolder()
    local paths = {
        Workspace:FindFirstChild("Zones"),
        Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("Zones"),
        Workspace:FindFirstChild("World") and Workspace.World:FindFirstChild("Zones"),
        workspace:FindFirstChild("Zones"),
    }
    for _, folder in ipairs(paths) do
        if folder then return folder end
    end
    return nil
end

local function getZoneRemote()
    if not Remotes then return nil end
    local services = {"ZonesService", "ZoneService", "WorldService", "AreaService"}
    for _, svcName in ipairs(services) do
        local svc = Remotes:FindFirstChild(svcName)
        if svc then
            local remote = svc:FindFirstChild("RemoteFunction") or svc:FindFirstChild("RemoteEvent")
            if remote then return remote, remote:IsA("RemoteEvent") end
        end
    end
    return nil, false
end

local function getHighestUnlockedZone(zonesFolder)
    if not zonesFolder then return nil end
    local zones = zonesFolder:GetChildren()
    if #zones == 0 then return nil end
    
    local bestZone = nil
    local highestNum = -1
    
    for _, zone in ipairs(zones) do
        if zone:IsA("Model") or zone:IsA("Folder") or zone:IsA("BasePart") then
            local numStr = zone.Name:match("%d+")
            if numStr then
                local num = tonumber(numStr)
                if num > highestNum then
                    highestNum = num
                    bestZone = zone
                end
            end
        end
    end
    
    if highestNum ~= -1 then
        return bestZone
    end
    
    return zones[#zones]
end

local function teleportToZone(zone)
    local hrp = GetHRP()
    if not hrp or not zone then return false end
    
    local targetCFrame = nil
    
    local commonNames = {"Spawn", "Teleport", "Floor", "Ground", "Base"}
    for _, name in ipairs(commonNames) do
        local part = zone:FindFirstChild(name, true)
        if part and part:IsA("BasePart") then
            targetCFrame = part.CFrame
            break
        end
    end
    
    if not targetCFrame and zone:IsA("Model") and zone.PrimaryPart then
        targetCFrame = zone.PrimaryPart.CFrame
    end
    
    if not targetCFrame then
        pcall(function()
            local pivot = zone:GetPivot()
            if pivot then targetCFrame = pivot end
        end)
    end
    
    if not targetCFrame then
        for _, descendant in ipairs(zone:GetDescendants()) do
            if descendant:IsA("BasePart") then
                targetCFrame = descendant.CFrame
                break
            end
        end
    end
    
    if not targetCFrame and zone:IsA("BasePart") then
        targetCFrame = zone.CFrame
    end
    
    if targetCFrame then
        hrp.CFrame = targetCFrame + Vector3.new(0, 10, 0)
        return true
    end
    
    return false
end

local function startAutoArea()
    autoAreaThread = task.spawn(function()
        local lastTeleportedZone = nil
        
        while autoAreaEnabled do
            local success, err = pcall(function()
                local currentZonesFolder = getZonesFolder()
                if not currentZonesFolder then
                    setStatus("zones folder not found")
                    return
                end
                
                local zoneRemote, isEvent = getZoneRemote()
                if zoneRemote then
                    if isEvent then
                        zoneRemote:FireServer("requestPurchaseZone")
                    else
                        pcall(function()
                            zoneRemote:InvokeServer("requestPurchaseZone")
                        end)
                    end
                end
                
                task.wait(1.5)
                
                currentZonesFolder = getZonesFolder()
                if not currentZonesFolder then return end
                
                local highestZone = getHighestUnlockedZone(currentZonesFolder)
                
                if highestZone and highestZone ~= lastTeleportedZone then
                    local tpSuccess = teleportToZone(highestZone)
                    if tpSuccess then
                        lastTeleportedZone = highestZone
                        setStatus("teleported to: " .. highestZone.Name)
                    else
                        setStatus("teleport failed for: " .. highestZone.Name)
                    end
                else
                    if lastTeleportedZone then
                        setStatus("auto area active")
                    end
                end
            end)
            
            if not success then
                setStatus("auto area error")
                warn("[KYYPIE AutoArea] Error: " .. tostring(err))
            end
            
            task.wait(3)
        end
    end)
end

local function enableAutoArea()
    if autoAreaEnabled then return end
    autoAreaEnabled = true
    setAutoArea(true)
    setStatus("auto area on")
    startAutoArea()
end

local function disableAutoArea()
    if not autoAreaEnabled then return end
    autoAreaEnabled = false
    setAutoArea(false)
    setStatus("auto area off")
    if autoAreaThread then
        task.cancel(autoAreaThread)
        autoAreaThread = nil
    end
end

