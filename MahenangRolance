local function findLootFolder()
    local names = {"Loot", "Drops", "LootFolder", "Items", "Collectibles"}
    for _, name in ipairs(names) do
        local f = workspace:FindFirstChild(name)
        if f then return f end
    end
    return workspace
end

local function startMagnet()
    magnetThread = task.spawn(function()
        while magnetEnabled do
            local lootFolder = findLootFolder()
            for _, obj in ipairs(lootFolder:GetChildren()) do
                if not collected[obj.Name] then
                    local ok = pcall(function()
                        if LootRemote then
                            LootRemote:InvokeServer("requestCollect", obj.Name)
                        end
                    end)
                    if ok then
                        collected[obj.Name] = true
                    end
                end
                task.wait(0.05)
            end
            task.wait(0.3)
        end
    end)
end

local function enableMagnet()
    if magnetEnabled then return end
    magnetEnabled = true
    setMagnet(true)
    setStatus("magnet on")
    startMagnet()
end

local function disableMagnet()
    if not magnetEnabled then return end
    magnetEnabled = false
    setMagnet(false)
    setStatus("magnet off")
    if magnetThread then
        task.cancel(magnetThread)
        magnetThread = nil
    end
end

MagnetBtn.MouseButton1Click:Connect(function()
    if magnetEnabled then disableMagnet() else enableMagnet() end
end)

