-- ========================
-- AUTO TELEPORT NEW UNLOCKED ZONE LOGIC
-- ========================

local function scanCurrentZones()
    local zonesFolder = getZonesFolder()
    if not zonesFolder then return {} end
    
    local zones = {}
    for _, zone in ipairs(zonesFolder:GetChildren()) do
        if zone:IsA("Model") or zone:IsA("Folder") or zone:IsA("BasePart") then
            zones[zone] = true
        end
    end
    return zones
end

local function startAutoTeleportNewZone()
    -- Initialize known zones
    knownZones = scanCurrentZones()
    
    autoTeleportNewZoneThread = task.spawn(function()
        while autoTeleportNewZoneEnabled do
            local success, err = pcall(function()
                local zonesFolder = getZonesFolder()
                if not zonesFolder then
                    setStatus("zones folder not found")
                    return
                end
                
                -- Check for new zones
                local currentZones = zonesFolder:GetChildren()
                local newZoneFound = nil
                
                for _, zone in ipairs(currentZones) do
                    if not autoTeleportNewZoneEnabled then break end
                    
                    if zone:IsA("Model") or zone:IsA("Folder") or zone:IsA("BasePart") then
                        if not knownZones[zone] then
                            -- New zone detected!
                            knownZones[zone] = true
                            newZoneFound = zone
                            break
                        end
                    end
                end
                
                -- Also check for removed zones (clean up)
                for zone in pairs(knownZones) do
                    if not zone.Parent then
                        knownZones[zone] = nil
                    end
                end
                
                -- Teleport to new zone if found
                if newZoneFound then
                    setStatus("new zone unlocked: " .. newZoneFound.Name)
                    task.wait(0.5) -- Small delay for server to settle
                    
                    local tpSuccess = teleportToZone(newZoneFound)
                    if tpSuccess then
                        setStatus("teleported to new zone: " .. newZoneFound.Name)
                    else
                        setStatus("tp failed: " .. newZoneFound.Name)
                    end
                end
            end)
            
            if not success then
                setStatus("auto tp new zone error")
                warn("[KYYPIE AutoTeleportNewZone] Error: " .. tostring(err))
            end
            
            task.wait(1) -- Check every second
        end
    end)
end

local function enableAutoTeleportNewZone()
    if autoTeleportNewZoneEnabled then return end
    autoTeleportNewZoneEnabled = true
    setAutoTeleportNewZone(true)
    setStatus("auto tp new zone on")
    startAutoTeleportNewZone()
end

local function disableAutoTeleportNewZone()
    if not autoTeleportNewZoneEnabled then return end
    autoTeleportNewZoneEnabled = false
    setAutoTeleportNewZone(false)
    setStatus("auto tp new zone off")
    if autoTeleportNewZoneThread then
        task.cancel(autoTeleportNewZoneThread)
        autoTeleportNewZoneThread = nil
    end
    knownZones = {}
end

AutoTeleportNewZoneBtn.MouseButton1Click:Connect(function()
    if autoTeleportNewZoneEnabled then 
        disableAutoTeleportNewZone() 
    else 
        enableAutoTeleportNewZone() 
    end
end)

